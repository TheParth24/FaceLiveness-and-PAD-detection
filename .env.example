# FaceLivenessPAD Environment Configuration
# Copy this file to .env and configure local settings

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Biometric Storage Paths (Relative to project root)
DATA_DIR=data
MODELS_DIR=models

# Security & Session Settings
SESSION_SECRET_KEY=change_this_to_a_random_cryptographic_key_in_production
SESSION_EXPIRATION_HOURS=12

# Presentation Attack Detection Thresholds
PAD_SCORE_THRESHOLD=0.50
IDENTITY_MATCH_THRESHOLD=0.60
PASSIVE_FRAME_ACCUMULATION_GATE=30
